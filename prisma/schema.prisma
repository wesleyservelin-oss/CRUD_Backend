generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Livros {
  id             Int      @id @default(autoincrement())
  titulo         String
  autor          String
  anoPublicacao  Int?
  isbn           String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
